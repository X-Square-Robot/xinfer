# CPU-image BF16 recipe. Source in Bash after the CANN runtime setup.
# Library/checkpoint paths stay with the caller; package defaults are unchanged.
# Clear selectors owned by the other recipe when switching models in one shell.
unset XINFER_COPYKILL_R2 XINFER_DECODEATTN_R4 XINFER_DECODEATTN_R4_ROW
unset XINFER_DECODEATTN_R4_SCAN XINFER_G2112_PREFQKV XINFER_G2112_TORCH_A
unset XINFER_G2112_TORCH_C XINFER_MX8_DOWN_PREPACK XINFER_MX8_DOWN_SPLITK
unset XINFER_RMSFUSE_R4 XINFER_SAMU_SIMD XINFER_SIMDEPI
unset XINFER_UBFINISH_R5

export XINFER_ASCEND_ACTION_PRECISION=bf16-round
export XINFER_CONVGEMM=1
export XINFER_FIA_FUSE=on
export XINFER_FINISHBF16=gateup,zba
export XINFER_GDNV=gdrprep
export XINFER_GLUEPI=prefillglu
export XINFER_GQA_GLUE=bhsd
export XINFER_MOVER2=gdrapply,gdrtailmix
export XINFER_R6B_BRIDGE=1
export XINFER_SMALLM_R3=gateup,down
export XINFER_SOUP2=qksq,rawsq,finplain
export XINFER_SOUPFORM=normprep,zbasplit,vropepack
export XINFER_SOUPKILL=finish,vrope
export XINFER_SOUPUNLOCK=rmsfull
export XINFER_SOUPUNLOCK_FROM_LAYER=0

# Shell values passed to the existing CLI, not additional runtime environment options.
ASCEND_MODEL_OPTIONS='{"quantization":"bf16","image_preprocess_device":"cpu","processing":{"noise_seed":20261112}}'
ASCEND_OP_BACKENDS=add_zero_centered_rms_norm=ascend:kernels
ASCEND_OP_BACKENDS+=,flow_input_embed=ascend:kernels
ASCEND_OP_BACKENDS+=,flow_velocity_euler=ascend:kernels
ASCEND_OP_BACKENDS+=,gated_causal_attention=ascend:kernels
ASCEND_OP_BACKENDS+=,gated_delta_net=ascend:kernels
ASCEND_OP_BACKENDS+=,gated_kvcache_attention=ascend:kernels
ASCEND_OP_BACKENDS+=,gated_residual_modulated_rms_norm=ascend:kernels
ASCEND_OP_BACKENDS+=,gemm_epilogue=ascend:kernels
ASCEND_OP_BACKENDS+=,gemm_glu_epilogue=ascend:kernels
ASCEND_OP_BACKENDS+=,gemm_split=ascend:kernels
ASCEND_OP_BACKENDS+=,identity_layer_norms_=ascend:kernels
ASCEND_OP_BACKENDS+=,modulated_rms_norm=ascend:kernels
ASCEND_OP_BACKENDS+=,qkv_norm_rope_kvcache=ascend:kernels
ASCEND_OP_BACKENDS+=,qkv_norm_split=ascend:kernels
ASCEND_OP_BACKENDS+=,qkv_rope_epilogue=ascend:kernels
ASCEND_OP_BACKENDS+=,qkv_rope_split=ascend:kernels
ASCEND_OP_BACKENDS+=,rope_full=ascend:kernels
ASCEND_OP_BACKENDS+=,segment_attention=ascend:kernels
ASCEND_OP_BACKENDS+=,zero_centered_rms_norm=ascend:kernels
