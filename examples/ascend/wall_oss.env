# CPU-image BF16 recipe. Source in Bash after the CANN runtime setup.
# Library/checkpoint paths stay with the caller; package defaults are unchanged.
# Clear selectors owned by the other recipe when switching models in one shell.
unset XINFER_CONVGEMM
unset XINFER_FIA_FUSE XINFER_FINISHBF16 XINFER_GDNV
unset XINFER_GLUEPI XINFER_GQA_GLUE XINFER_MOVER2
unset XINFER_R6B_BRIDGE XINFER_SOUP2 XINFER_SOUPFORM
unset XINFER_SOUPKILL XINFER_SOUPUNLOCK XINFER_SOUPUNLOCK_FROM_LAYER

export XINFER_ASCEND_ACTION_PRECISION=bf16-round
export XINFER_COPYKILL_R2=k2,k3,k4,k5,k7
export XINFER_DECODEATTN_R4=1
export XINFER_DECODEATTN_R4_ROW=1
export XINFER_DECODEATTN_R4_SCAN=b
export XINFER_G2112_PREFQKV=1
export XINFER_G2112_TORCH_A=1
export XINFER_G2112_TORCH_C=1
export XINFER_MX8_DOWN_PREPACK=1
export XINFER_MX8_DOWN_SPLITK=4
export XINFER_RMSFUSE_R4=m16,f32in,h2048w
export XINFER_SAMU_SIMD=1
export XINFER_SIMDEPI=1
export XINFER_SMALLM_R3=oproj,gateup,down
export XINFER_UBFINISH_R5=1

# Shell values passed to the existing CLI, not additional runtime environment options.
ASCEND_MODEL_OPTIONS='{"quantization":"bf16","image_preprocess_device":"cpu","processing":{"noise_seed":20261112}}'
ASCEND_OP_BACKENDS=add_rms_norm=ascend:kernels
ASCEND_OP_BACKENDS+=,causal_attention=ascend:kernels
ASCEND_OP_BACKENDS+=,flow_velocity_euler=ascend:kernels
ASCEND_OP_BACKENDS+=,gemm_add_rms_norm=ascend:kernels
ASCEND_OP_BACKENDS+=,gemm_epilogue=ascend:kernels
ASCEND_OP_BACKENDS+=,gemm_glu_epilogue=ascend:kernels
ASCEND_OP_BACKENDS+=,mlp_add_rms_norm=ascend:kernels
ASCEND_OP_BACKENDS+=,prefix_kvcache_attention=ascend:kernels
ASCEND_OP_BACKENDS+=,qkv_rope_epilogue=ascend:kernels
ASCEND_OP_BACKENDS+=,qkv_rope_kvcache=ascend:kernels
ASCEND_OP_BACKENDS+=,qkv_rope_split=ascend:kernels
ASCEND_OP_BACKENDS+=,rms_norm=ascend:kernels
ASCEND_OP_BACKENDS+=,varlen_attention=ascend:kernels
