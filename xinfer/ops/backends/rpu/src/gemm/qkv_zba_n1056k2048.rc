// Local A[384,2048] @ W[2048,1056], on each of eight TP cores.
// B and A each occupy one padded N16 block; lanes 2..15 must be zero.
#define STREAMED_ENTRY qkv_zba_n1056k2048
#define STREAMED_QKV_ZBA 1
#define STREAMED_N 1056
#define STREAMED_K 2048
#ifndef STREAMED_TN
#define STREAMED_TN 48
#endif
#ifndef STREAMED_TM
#define STREAMED_TM 384
#endif
#ifndef STREAMED_TK
#define STREAMED_TK 128
#endif
#ifndef STREAMED_PIPELINE
#define STREAMED_PIPELINE 6
#endif
#include "streamed_qkv.h"
