// Local A[rows,2048] @ W[2048,1056] on each of eight TP cores, rows 385..448.
// B and A each occupy one padded N16 block; lanes 2..15 must be zero.
#define STREAMED_ENTRY qkv_zba_m448_k128
#define STREAMED_N 1056
#define STREAMED_K 2048
#define STREAMED_TM 448
#define STREAMED_OUTPUT_QKV_ZBA 1
#include "streamed_k128.h"
