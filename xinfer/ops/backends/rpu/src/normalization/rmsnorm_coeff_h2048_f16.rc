#include "__clang_rpu_builtin_vars.h"
using namespace rpu;

// Private unqualified explicit coefficient-first Text RMS candidate.
// Rowwise FP16 RMSNorm. One independent X[M,C], W[C], Y[M,C] lives in each
// active core's LocalSPM. One block owns 16 rows. VMAT accumulates squares in
// FP32 and applies 1/C before its FP16 result; range-conditioned re-reduction
// keeps that FP16 result finite and nonzero for both large and tiny rows.
// The host ABI admits exact X==Y, but never partial aliasing or Y/W aliasing.
__rprog__ void rmsnorm_coeff_h2048_f16(
    half *dst, half *src, half *weight,
    unsigned short rows, unsigned short cols,
    unsigned short mean_scale_low, unsigned short mean_scale_high,
    half epsilon) {
  // Shapes are validated by the host ABI before the managed eight-core launch.
  const unsigned short tid = threadId;
  const unsigned short chunks = cols / 16;
  const unsigned int row = (unsigned int)blockIdx.x * 16 + tid;
  const unsigned int load_row = row < rows ? row : (unsigned int)rows - 1;
  const int row_offset = (int)(load_row * (unsigned int)cols);

  __local__ f16v16 x[128], gamma[128];
  __local__ f16v16 gram[1], norm[1], scratch[1];

  vcfg_set_valu(vcfg_valu_target::imm0, (half)1.0f);
  vcfg_set_valu(vcfg_valu_target::imm1, (half)1.0f);
  vcfg_set_valu(vcfg_valu_target::imm2, (half)1.0f);
  vcfg_set_vmat(vcfg_vmat_target::acc_init_fp32_l, (short)0);
  vcfg_set_vmat(vcfg_vmat_target::acc_init_fp32_h, (short)0);
  vcfg_set_vmat(vcfg_vmat_target::scale_allch_l, (short)mean_scale_low);
  vcfg_set_vmat(vcfg_vmat_target::scale_allch_h, (short)mean_scale_high);

  vldSetTsize32B(chunks, 1);
  vldSetTstep32B_0(1, 16);
  vldSetTstep32B_1(0, 0);
  vldRepeat(x, src, row_offset);
  vldRepeat(gamma, weight, (int)0);

  vmatSetTsize(chunks, 1);
  vmatSetTstep0(0, 1, 1);
  vmatSetTstep1(0, 0, 0);
  LoopOutInfo outlp[1] = {{(short)0}};
  LoopClrInfo clrlp[1] = {{(short)0}};
  LoopOutLPAttr out(outlp);
  LoopClrLPAttr clr(clrlp);
  vmatRepeat(gram, x, x, &out, &clr);

  // A dynamic scalar Psel(threadId) selects column zero on this SDK. First
  // broadcast this thread's diagonal through VALU, then extract fixed lane 0.
  // sumint is the warp's unsigned minimum; complementing finds its maximum.
  half mean_square;
  vcfg_set_valu(vcfg_valu_target::imm2, gram, (short)tid);
  valuExecute(scratch, (half)1.0f, (half)0.0f, __ValuOpc::add);
  vcfg_set_valu(vcfg_valu_target::imm2, (half)1.0f);
  vsfuScalar(mean_square, scratch, (short)0, __ShuffleMode::Psel);
  const unsigned short bits = reinterpret_cast<unsigned short&>(mean_square);
  const unsigned short any_small = sumint(bits);
  const unsigned short any_large = sumint((unsigned short)(0xffffu - bits));

  valuSetTsize(chunks, 1);
  valuSetTstep0(1, 1, 0);
  valuSetTstep1(0, 0, 0);
  half adjusted_epsilon = epsilon;
  if (any_small < 0x0400u || any_large <= 0x83ffu) {
    // 1/256 keeps even a dense row of maximum finite FP16 inputs within the
    // FP16 mean-square range. 128 lifts subnormal means into normal range.
    // All 16 lanes reconverge before the second VMAT reduction.
    // Keep the scale and epsilon choices in explicit assignments.
    half scale = (half)1.0f;
    if (bits < 0x0400u) {
      scale = (half)128.0f;
      adjusted_epsilon = (half)0.016384f;
    } else if (bits >= 0x7c00u) {
      scale = (half)0.00390625f;
      adjusted_epsilon = (half)0.0f;
    }
    valuRepeat(x, x, scale, __ValuOpc::mul);
    vmatRepeat(gram, x, x, &out, &clr);
    vcfg_set_valu(vcfg_valu_target::imm2, gram, (short)tid);
    valuExecute(scratch, (half)1.0f, (half)0.0f, __ValuOpc::add);
    vcfg_set_valu(vcfg_valu_target::imm2, (half)1.0f);
    vsfuScalar(mean_square, scratch, (short)0, __ShuffleMode::Psel);
  }

  valuExecute(norm, mean_square, adjusted_epsilon, __ValuOpc::add);
  valuExecute(norm, norm, (half)0.0f, __ValuOpc::sqrt_reciprocal);
  // Explicit Text-only coefficient-first association. Each native MUL
  // materializes FP16, preserving two distinct rounds. The original RMS
  // entry keeps x*inverse followed by *gamma. Here only VLM gamma is changed;
  // caller-owned SPM weight remains immutable. No VALU postscale is used.
  valuRepeat(gamma, gamma, norm, __ValuOpc::mul);
  valuSetTstep0(1, 1, 1);
  valuRepeat(x, x, gamma, __ValuOpc::mul);
  vstSetTsize32B(chunks, 1);
  vstSetTstep32B_0(1, 16);
  vstSetTstep32B_1(0, 0);
  if (row < rows) vstRepeat(x, dst, row_offset);
}
