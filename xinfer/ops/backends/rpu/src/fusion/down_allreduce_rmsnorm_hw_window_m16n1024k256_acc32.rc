// Compatibility alias for the WINDOW occurrence of the Action M16
// down+all-reduce+norm fusion. Body is identical to the plain entry plus
// the private-window counter ABI: occurrence i runs global counter 34+i
// with the local rendezvous pair {2+2i, 3+2i}. The trailing rsqrt_lut
// formal is ABI padding only; the kernel never reads it.
#define XINFER_ACTION_DOWN_KERNEL down_allreduce_rmsnorm_hw_window_m16n1024k256_acc32
#define XINFER_ACTION_DOWN_RSQRT_LUT 1
#define XINFER_ACTION_DOWN_WINDOW 1
#include "down_allreduce_rmsnorm_m16n1024k256_acc32_impl.h"
