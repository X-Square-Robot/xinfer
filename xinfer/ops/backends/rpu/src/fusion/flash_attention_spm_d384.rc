#include "__clang_rpu_builtin_vars.h"
using namespace rpu;

// 3 x (kcache_insert_f16 + vcache_insert_f16) + flash_attention_varlen_f16:
// noncausal varlen attention for TP8 Vision (2 local heads,
// D64, scale 1/8, 1..3 packed images of length 1..308) that reads K and V
// directly from the compact per-core [S,2,64] LocalSPM outputs of the Q/K/V
// projection. No DDR cache, insert launch or DDR K/V read remains.
//
// Bit-identical to the chain. The VLM K/V tiles equal the ones
// flash_attention_varlen_f16 loads from the 7D caches for every valid key:
// K keeps thread = key token; V is loaded with thread = key token and
// warp-transposed (VSFU Trs, bit-exact) to thread = dimension, as
// vcache_insert_f16 does before its store. Padding keys of a partial last
// block re-read the image's last row, so every K/V value is finite; their
// scores become exactly -65504 (the chain's mask value) through min() with a
// lane mask, so their probabilities are exactly 0 and their V lanes add 0.
// Every per-row step (two QK passes centred in the FP32 accumulator, FP16
// exp, FP32 denominator, FP16 division, FP32 PV) keeps the chain's order;
// VMAT Repeat accumulates the same D16/key-block tiles in the same order.
//
// Schedule. The work list is every Q16 group ordered (image, head, group);
// each of the gridDim.x resident blocks takes one contiguous equal share and
// reloads K/V only when its (image, head) pair changes (a Q64 tile per block
// left the busiest warp of [112,140,140] with 9 groups against a mean of
// 6.25). Each stage issues its VMAT work asynchronously with one fence.
//
// Keep loop-invariant lane masks outside repeated loops.
// Initialize each denominator input immediately before its use.
// Compute row maxima with one VALU max per key block.
// Stage and transpose V in two bounded tiles within the declared arena.
// Grid = [8, 1, 1], TP8 broadcast. ABI: dst [0:1], query [2:3], key [4:5],
// value [6:7], len0 [8], len1 [9], len2 [10] (absent images have length 0).
__rprog__ void flash_attention_spm_d384(half *dst, half *query, half *key,
    half *value, unsigned short len0, unsigned short len1,
    unsigned short len2) {
  if (len0 == 0 || len0 > 308 || len1 > 308 || len2 > 308 ||
      (len1 == 0 && len2 != 0) || blockIdx.y != 0 || blockIdx.z != 0) return;
  const unsigned short g0 = (len0 + 15) / 16, g1 = (len1 + 15) / 16;
  const unsigned short g2 = (len2 + 15) / 16;
  const unsigned short total = 2 * (g0 + g1 + g2);
  const unsigned short warps = gridDim.x, block = blockIdx.x;
  const unsigned short first = block * total / warps;
  const unsigned short last = (block + 1) * total / warps;
  if (first >= last) return;
  constexpr short key_blocks = 20, half_blocks = key_blocks / 2;
  __local__ f16v16 arena[4 + 4 + 7 + key_blocks + 4 * key_blocks +
                         4 * key_blocks + 4 * half_blocks];
  auto *q = arena, *out = q + 4, *maximum = out + 4, *tmp = maximum + 1;
  auto *denominator = tmp + 1, *ones = denominator + 1, *keymask = ones + 1;
  auto *score = keymask + 3, *k = score + key_blocks;
  auto *v = k + 4 * key_blocks, *staged = v + 4 * key_blocks;
  vcfg_set_valu(vcfg_valu_target::imm0, (half)1);
  vcfg_set_valu(vcfg_valu_target::imm1, (half)1);
  vcfg_set_valu(vcfg_valu_target::imm2, (half)1);
  const unsigned short t0 = len0 & 15, t1 = len1 & 15, t2 = len2 & 15;
  valuExecute(tmp, (half)65504, (half)0, __ValuOpc::add);
  if (threadId >= t0) valuExecute(tmp, (half)-65504, (half)0, __ValuOpc::add);
  vsfuExecute(keymask, tmp, (short)0, __ShuffleMode::Trs);
  valuExecute(tmp, (half)65504, (half)0, __ValuOpc::add);
  if (threadId >= t1) valuExecute(tmp, (half)-65504, (half)0, __ValuOpc::add);
  vsfuExecute(keymask + 1, tmp, (short)0, __ShuffleMode::Trs);
  valuExecute(tmp, (half)65504, (half)0, __ValuOpc::add);
  if (threadId >= t2) valuExecute(tmp, (half)-65504, (half)0, __ValuOpc::add);
  vsfuExecute(keymask + 2, tmp, (short)0, __ShuffleMode::Trs);
  short loaded = -1;
#pragma rpu_hwloop_ul
  for (short item = first; item < last; ++item) {
    // item -> (pair, group); pairs ordered (image, head).
    short rest = item, pair = 0, groups = g0;
    if (rest >= g0) { rest -= g0; pair = 1; }
    if (pair == 1 && rest >= g0) { rest -= g0; pair = 2; groups = g1; }
    if (pair == 2 && rest >= g1) { rest -= g1; pair = 3; }
    if (pair == 3 && rest >= g1) { rest -= g1; pair = 4; groups = g2; }
    if (pair == 4 && rest >= g2) { rest -= g2; pair = 5; }
    const unsigned short image = sselt((short)(pair >> 1), 0), head = sselt((short)(pair & 1), 0);
    const short group = sselt(rest, 0);
    short selected_length = len2, selected_start = len0 + len1;
    if (image == 0) { selected_length = len0; selected_start = 0; }
    if (image == 1) { selected_length = len1; selected_start = len0; }
    const unsigned short length = sselt(selected_length, 0);
    const unsigned short start = sselt(selected_start, 0);
    const short blocks = sselt(groups, 0);
    const bool partial = (length & 15) != 0;
    if (pair != loaded) {
      loaded = pair;
#pragma rpu_hwloop_ul
      for (short b = 0; b < blocks; ++b) {
        unsigned short token = (unsigned short)(b * 16) + threadId;
        unsigned short row = token < length ? token : length - 1;
        int row_base = (int)(start + row) * 128 + head * 64;
#pragma rpu_hwloop_ul
        for (short d = 0; d < 4; ++d)
          vldExecute_async(k + b * 4 + d, key, row_base + d * 16);
      }
      // V half h holds key blocks [h*10, h*10+10): stage, then transpose to
      // dimension-major v[d*20 + block].
#pragma rpu_hwloop_ul
      for (short h = 0; h < 2; ++h) {
        const short b0 = h * half_blocks;
        const short nb = blocks - b0 < half_blocks ? blocks - b0 : half_blocks;
        if (nb > 0) {
#pragma rpu_hwloop_ul
          for (short b = 0; b < nb; ++b) {
            unsigned short token = (unsigned short)((b0 + b) * 16) + threadId;
            unsigned short row = token < length ? token : length - 1;
            int row_base = (int)(start + row) * 128 + head * 64;
#pragma rpu_hwloop_ul
            for (short d = 0; d < 4; ++d)
              vldExecute_async(staged + b * 4 + d, value, row_base + d * 16);
          }
          fenceVld(0);
          vsfuSetTsize32B(4, nb);
          vsfuSetTstep32B_0(key_blocks, 1, 0);
          vsfuSetTstep32B_1(1, 4, 0);
          vsfuRepeat(v + b0, staged, (short)0, __ShuffleMode::Trs);
        }
      }
      fenceVld(0);
    }
    unsigned short qrow = (unsigned short)(group * 16) + threadId;
    unsigned short load_q = qrow < length ? qrow : length - 1;
#pragma rpu_hwloop_ul
    for (short d = 0; d < 4; ++d)
      vldExecute_async(q + d, query, (int)(start + load_q) * 128 + head * 64 + d * 16);
    fenceVld(0);
    vcfg_set_vmat(vcfg_vmat_target::scale_allch_l, (short)0);
    vcfg_set_vmat(vcfg_vmat_target::scale_allch_h, (short)0x3e00);
    LoopOutInfo outlp[1] = {{(short)0}};
    LoopClrInfo clrlp[1] = {{(short)0}};
    LoopOutLPAttr oa(outlp);
    LoopClrLPAttr ca(clrlp);
    vmatSetTsize(4, 1);
    vmatSetTstep0(0, 1, 1);
    vmatSetTstep1(0, 0, 0);
#pragma rpu_hwloop_ul
    for (short b = 0; b < blocks; ++b)
      vmatRepeat_async(score + b, q, k + b * 4, &oa, &ca);
    fenceVmat(0);
    if (partial)
      valuExecute(score + blocks - 1, score + blocks - 1, keymask + image, __ValuOpc::min);
    valuExecute(maximum, (half)-65504, (half)0, __ValuOpc::add);
#pragma rpu_hwloop_ul
    for (short b = 0; b < blocks; ++b)
      valuExecute(maximum, maximum, score + b, __ValuOpc::max);
#pragma rpu_hwloop_ul
    for (short stage = 0; stage < 4; ++stage) {
      short distance = 1 << stage;
      vsfuExecute(tmp, maximum, distance, __ShuffleMode::Pselr);
      valuExecute(maximum, maximum, tmp, __ValuOpc::max);
    }
    valuExecute(tmp, maximum, (half)-8, __ValuOpc::mul);
#pragma rpu_hwloop_ul
    for (short b = 0; b < blocks; ++b) {
      vcfg_set_vmat(vcfg_vmat_target::acc_init_fp16, tmp);
      vmatRepeat_async(score + b, q, k + b * 4, &oa);
    }
    fenceVmat(0);
    if (partial)
      valuExecute(score + blocks - 1, score + blocks - 1, keymask + image, __ValuOpc::min);
    valuSetTsize(blocks, 1);
    valuSetTstep0(1, 1, 0);
    valuSetTstep1(0, 0, 0);
    valuRepeat(score, score, (half)0, __ValuOpc::exp);
    valuExecute(ones, (half)1, (half)0, __ValuOpc::add);
    vcfg_set_vmat(vcfg_vmat_target::scale_allch_h, (short)0x3f80);
    vmatSetTsize(blocks, 1);
    vmatSetTstep0(0, 1, 0);
    vmatRepeat_async(denominator, score, ones, &oa, &ca);
    fenceVmat(0);
    valuSetTstep0(1, 1, 0);
    valuRepeat(score, score, denominator, __ValuOpc::div);
    vmatSetTstep0(0, 1, 1);
#pragma rpu_hwloop_ul
    for (short d = 0; d < 4; ++d)
      vmatRepeat_async(out + d, score, v + d * key_blocks, &oa, &ca);
    fenceVmat(0);
    if (qrow < length) {
#pragma rpu_hwloop_ul
      for (short d = 0; d < 4; ++d)
        vstExecute_async(out + d, dst, (int)(start + qrow) * 128 + head * 64 + d * 16);
    }
    fenceVst(0);
  }
}
