// Compatibility alias for down_allreduce_rmsnorm_m32n1024k256_acc32.
// Body is the hardware sqrt_reciprocal + valuRepeat path shared with the
// plain entry. RSQRT_LUT=1 keeps the trailing rsqrt_lut formal as ABI
// padding; the kernel never reads it.
#define XINFER_ACTION_DOWN_KERNEL down_allreduce_rmsnorm_hw_m32n1024k256_acc32
#define XINFER_ACTION_DOWN_RSQRT_LUT 1
#include "down_allreduce_rmsnorm_m32n1024k256_acc32_impl.h"
