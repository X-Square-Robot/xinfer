// fc1_n512k4096 + gelu_f16 (erf): C = gelu_erf(A[M,4096] @ B[4096,512] + bias),
// local N512 K4096, M 1..147. Same tiles, K streaming and ABI as fc1_n512k4096;
// gelu_f16's approximate=0 sequence runs on each rounded FP16 output tile in
// VLM before its only store, so the result is bit-identical to fc1_n512k4096
// followed by an in-place gelu_f16 with approximate=0.
#include "mlp_fusion_epilogue.h"
#define PROJ_ENTRY fc1_gelu_n512k4096
#define PROJ_N 512
#define PROJ_K 4096
#define PROJ_TN 16
#define PROJ_TM 16
#define PROJ_TK 1024
#define PROJ_EPILOGUE(r, scratch, count) vf_gelu_erf(r, scratch, count)
#include "../gemm/mlp_projection.h"
